<?xml version="1.0" encoding="utf-8"?>
<!-- Backup rules for Android 12+. The settings DataStore holds the encrypted API key, whose
     Keystore key can't leave the device, so keep it out of cloud backup and device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/settings.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/settings.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
